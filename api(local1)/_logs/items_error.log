        SELECT
            'alat' AS source,
            id,
            jurusan,
            nama,
            stok,
            satuan,
            kondisi AS extra
        FROM barangbhp_alat
        WHERE jurusan = :jurusan
            AND (`delete` IS NULL OR `delete` = '-')
        
        UNION ALL
        
        SELECT
            'bahan' AS source,
            id,
            jurusan,
            nama,
            stok,
            satuan,
            CONCAT(
                IFNULL(kimia, '-'),
                ' | exp:',
                IFNULL(DATE_FORMAT(tgl_expired, '%Y-%m-%d'), '-')
            ) AS extra
        FROM barangbhp_bahan
        WHERE jurusan = :jurusan
            AND (`delete` IS NULL OR `delete` = '-')
        
        UNION ALL
        
        SELECT
            'inventaris' AS source,
            id,
            jurusan,
            nama,
            stok,
            satuan,
            CONCAT(
                IFNULL(kode_barang, '-'),
                ' | ',
                IFNULL(ruang, '-')
            ) AS extra
        FROM barang_inventaris
        WHERE jurusan = :jurusan
            AND (`delete` IS NULL OR `delete` = '-')
        
        ORDER BY (stok > 0) DESC, nama ASC
    
SQL_RAW_END
