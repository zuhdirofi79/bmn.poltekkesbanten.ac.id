                IFNULL(b.kimia, '-'),
                ' | exp:',
                IFNULL(DATE_FORMAT(b.tgl_expired, '%Y-%m-%d'), '-')
            ) AS extra,
            COALESCE(SUM(pd.stok_pinjam), 0) AS stok_dipinjam
        FROM barangbhp_bahan b
        LEFT JOIN peminjaman_detail pd ON pd.barang_id = b.id
