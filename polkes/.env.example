APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production: APP_DEBUG MUST be false. Logs only — never expose errors to users.
APP_DEBUG=true
APP_URL=http://localhost
DISABLE_BHP_NOTIFICATIONS=false

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# BHP reminder uses sync (no queue workers). Keep as sync on shared hosting.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# BMN: path absolut & URL publik (shared hosting: docroot = public_html sering BUKAN folder /public Laravel).
# Contoh production:
# BMN_FOTO_BASE_PATH=/home/u708283844/domains/bmn.poltekkesbanten.ac.id/public_html/uploads/foto_bmn
# BMN_FOTO_BASE_URL=https://bmn.poltekkesbanten.ac.id/uploads/foto_bmn
# Kosong = pakai public/uploads/foto_bmn & APP_URL + /uploads/foto_bmn
BMN_FOTO_BASE_PATH=
BMN_FOTO_BASE_URL=

# BMN: lokasi fisik & URL Nota Dinas Peminjaman.
# WAJIB di-set pada hosting cPanel/Hostinger di mana Laravel di-deploy di
# subfolder (mis. public_html/polkes/) karena public_path() menunjuk ke
# polkes/public — BUKAN ke document root publik yang diakses browser.
# Akibat tidak di-set: file PDF tersimpan di polkes/public/uploads/nota_dinas
# tapi URL https://domain/uploads/nota_dinas/... mengarah ke public_html/uploads/nota_dinas
# → 404.
# Contoh production:
# BMN_NOTA_DINAS_BASE_PATH=/home/u708283844/domains/bmn.poltekkesbanten.ac.id/public_html/uploads/nota_dinas
# BMN_NOTA_DINAS_BASE_URL=https://bmn.poltekkesbanten.ac.id/uploads/nota_dinas
# Kosong = pakai public/uploads/nota_dinas & APP_URL + /uploads/nota_dinas
BMN_NOTA_DINAS_BASE_PATH=
BMN_NOTA_DINAS_BASE_URL=

# BMN: lokasi fisik & URL Bukti Bayar Sewa (surat resmi memakai NOTA_DINAS di atas).
# Contoh production:
# BMN_BUKTI_BAYAR_SEWA_BASE_PATH=/home/u708283844/domains/bmn.poltekkesbanten.ac.id/public_html/uploads/bukti_bayar_sewa
# BMN_BUKTI_BAYAR_SEWA_BASE_URL=https://bmn.poltekkesbanten.ac.id/uploads/bukti_bayar_sewa
BMN_BUKTI_BAYAR_SEWA_BASE_PATH=
BMN_BUKTI_BAYAR_SEWA_BASE_URL=
